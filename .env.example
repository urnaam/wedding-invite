# Choose ONE database and set DATABASE_URL accordingly.
# Recommended for this project: Supabase (free Postgres, works great with Vercel + Prisma)
# 1. Create a project at https://supabase.com
# 2. Project Settings -> Database -> Connection string (URI, "Transaction" pooler for serverless)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
# Alternative for quick local testing only (does NOT work on Vercel serverless):
# DATABASE_URL="file:./dev.db"

# Password for the /admin dashboard (RSVP overview + CSV export). Pick something only you know.
ADMIN_PASSWORD="change-me"
